<div class="rolls">
    <button type="button" data-action="oracle">{{localize "mune.Oracle.Name"}}</button>
    <button type="button" data-action="intervention" class="{{#if doIntervention}}highlight{{/if}}">{{localize "mune.Intervention.Name"}}</button>
    <button type="button" data-action="portent">{{localize "mune.Portent.Name"}}</button>
    <button type="button" data-action="npcInteraction">{{localize "mune.NPCInteraction.Name"}}</button>
    <button type="button" data-action="twene">{{localize "mune.TWENE.Name"}}</button>
</div>

<hr>

<div class="info">
    <div class="intervention">
        <span>{{localize "mune.InterventionPoints.Name.Plural"}}: {{interventionPoints}}</span>
        <div class="intervention-controls">
            <a data-action="interventionSubtract"><i class="fas fa-minus"></i></a>
            <a data-action="interventionAdd"><i class="fas fa-plus"></i></a>
        </div>
    </div>
</div>

<hr>

<div class="help">
    <a data-action="help">{{localize "mune.Info"}}</a>
</div>

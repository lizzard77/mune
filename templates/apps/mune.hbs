<div id="mune" class="app">
    <div class="rolls">
        <button data-action="oracle">{{localize "mune.Oracle.Name"}}</button>
        <button data-action="intervention" class="{{#if doIntervention}}highlight{{/if}}">{{localize "mune.Intervention.Name"}}</button>
        <button data-action="portent">{{localize "mune.Portent.Name"}}</button>
        <button data-action="npcInteraction">{{localize "mune.NPCInteraction.Name"}}</button>
        <button data-action="twene">{{localize "mune.TWENE.Name"}}</button>
    </div>

    <hr>

    <div class="info">
        <div class="intervention flexrow">
            <button style="flex: 0;" data-action="interventionControl" data-mode="subtract"><i class="fas fa-minus"></i></button>
            <div style="flex: 1; text-align: center;;">{{localize "mune.InterventionPoints.Name.Plural"}}: {{info.interventionPoints.total}}</div>
            <button style="flex: 0;" data-action="interventionControl" data-mode="add"><i class="fas fa-plus"></i></button>
        </div>
    </div>

    <hr>

    <div class="help">
        <a data-action="help">{{localize "mune.Info"}}</a>
    </div>
</div>
